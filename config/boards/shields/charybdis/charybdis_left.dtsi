#include "charybdis.dtsi"
/ {
	kscan0: kscan {
		compatible = "zmk,kscan-gpio-direct";
		label = "KSCAN";
		input-gpios = <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

// I2C for OLED on nice!nano
&pro_micro_i2c {
	status = "okay";
	sda-pin = <30>;    // P0.30
	scl-pin = <31>;    // P0.31
};
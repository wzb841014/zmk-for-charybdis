#include "charybdis.dtsi"                                                                                            
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h> 
/ {
    /* SPI 引脚配置 */
    spi0_default: spi0_default {
        sck {
            nrf-pinctrl-single = <NRF_PSEL(SPI_SCK, 0, 17)>;
        };
        mosi {
            nrf-pinctrl-single = <NRF_PSEL(SPI_MOSI, 0, 15)>;
        };
        miso {
            nrf-pinctrl-single = <NRF_PSEL(SPI_MISO, 0, 13)>;
        };
    };

    /* GC9A01 显示屏定义 */
    gc9a01: gc9a01 {
        compatible = "sitronix,gc9a01";
        label = "GC9A01";
        spi-dev = <&spi0>;
        reset-gpios = <&gpio0 22 (GPIO_ACTIVE_LOW)>;
        dc-gpios = <&gpio0 23 (GPIO_ACTIVE_HIGH)>;
        cs-gpios = <&gpio0 20 (GPIO_ACTIVE_LOW)>;
        width = <240>;
        height = <240>;
        rotation = <0>;
        x-offset = <0>;
        y-offset = <0>;
    };
};

&spi0 {
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-names = "default";
};

&kscan {
    compatible = "zmk,kscan-gpio-matrix";
    row-gpios = <&gpio0 1 (GPIO_ACTIVE_HIGH)>;
    col-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH)>;
};                                                                                    
